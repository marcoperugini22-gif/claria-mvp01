# --- Database ---
# Per sviluppo locale puoi usare Postgres in Docker oppure un servizio cloud (Neon, Supabase, Railway)
# Esempio locale: postgresql://postgres:postgres@localhost:5432/claria?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/claria?schema=public"

# --- OpenAI (per la generazione di consigli personalizzati) ---
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# --- App ---
NEXT_PUBLIC_APP_NAME="Claria"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
